# === Telegram ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === AgentRouter ===
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
LLM_MODEL=deepseek-v4-pro

# === Limits ===
MAX_QUERY_LENGTH=500
MAX_RESPONSE_LENGTH=4000
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# === Anti-spam ===
COOLDOWN_SECONDS=3.0

# === Inline ===
INLINE_CACHE_TIME=5

# === Logging ===
LOG_LEVEL=INFO
