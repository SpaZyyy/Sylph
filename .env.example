# === Telegram ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === Google Gemini ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# === Limits ===
MAX_QUERY_LENGTH=500
MAX_RESPONSE_LENGTH=4000
GEMINI_TIMEOUT=30
GEMINI_MAX_RETRIES=3

# === Anti-spam ===
COOLDOWN_SECONDS=3.0

# === Inline ===
INLINE_CACHE_TIME=5

# === Logging ===
LOG_LEVEL=INFO
