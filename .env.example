# === Telegram ===
TELEGRAM_BOT_TOKEN=<BotFather_Token>

# === Mistral ===
MISTRAL_API_KEY=<Mistral_API_Key>
MISTRAL_MODEL=mistral-large-latest

# === System prompt (optional) ===
# SYSTEM_PROMPT=You are Sylph, a helpful and concise assistant.

# === Limits ===
MAX_QUERY_LENGTH=500
MAX_RESPONSE_LENGTH=3800
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# === Anti-spam ===
COOLDOWN_SECONDS=3.0

# === Inline ===
INLINE_CACHE_TIME=5

# === Cache TTL (seconds) ===
CACHE_TTL=300

# === Logging ===
LOG_LEVEL=INFO
